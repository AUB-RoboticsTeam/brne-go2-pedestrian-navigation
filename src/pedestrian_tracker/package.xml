<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pedestrian_tracker</name>
  <version>0.0.0</version>
  <description>YOLO pedestrian tracking and BRNE input adapters</description>
  <maintainer email="RoboLI@aub.edu.lb">user</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>yolo_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>unitree_api</depend>
  <depend>unitree_go</depend>
  <depend>crowd_nav_interfaces</depend>
  <depend>ament_index_python</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>crowd_nav</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
